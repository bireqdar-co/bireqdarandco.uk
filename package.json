{
  "name": "bireqdar-storefront-v1",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "postinstall": "node scripts/vendor-three.js",
    "vendor:three": "node scripts/vendor-three.js",
    "test": "node --test --test-concurrency=1 \"tests/unit/*.test.cjs\" \"tests/integration/*.test.cjs\" \"tests/api/*.test.cjs\"",
    "test:unit": "node --test \"tests/unit/*.test.cjs\"",
    "test:api": "node --test --test-concurrency=1 \"tests/api/*.test.cjs\"",
    "test:db": "node --test \"tests/integration/*.test.cjs\"",
    "test:e2e": "node --test --test-timeout=900000 \"tests/e2e/*.e2e.cjs\"",
    "test:smoke": "node --test --test-name-pattern=\"SMK-\" \"tests/api/platform.test.cjs\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "argon2": "0.45.1",
    "google-auth-library": "^11.3.3",
    "pg": "^8.16.3",
    "three": "^0.187.0"
  },
  "allowScripts": {
    "argon2@0.45.1": true
  }
}
