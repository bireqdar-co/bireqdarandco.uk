# Copy this file to .env for local use. Keep .env private.
PORT=3000
HOST=127.0.0.1
APP_URL=http://localhost:3000
# Optional: set this to a managed PostgreSQL connection URL for durable storage.
DATABASE_URL=
# Keep false until database, domain, Stripe webhooks, tax and fulfilment settings are verified.
LIVE_CHECKOUT_ENABLED=false
# Optional: add Stripe credentials only after creating and configuring the Stripe account.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: if set, this key replaces the random first-run key printed by the server.
ADMIN_SETUP_KEY=
# Private staff studio address: a slug of at least 16 letters, digits, "-" or "_".
# The studio is then served at http://localhost:3000/<ADMIN_PATH> and /admin.html returns 404.
# Required in production; without it the studio is only available at /admin.html in development.
ADMIN_PATH=
# Encrypts staff authenticator (two-factor) secrets at rest. Any long random string; do not change once set.
STAFF_MFA_KEY=
# Optional: Resend transactional email for password resets, account verification and order updates. Verify a sending domain in Resend first.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Optional Google Identity Services client ID. The sign-in option appears when configured.
GOOGLE_CLIENT_ID=
